DB_HOST=localhost
DB_PORT=5432
DB_NAME=atec
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=atec
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_APPLICATION_NAME=atec-backend

PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BASE_PATH=/atec
BACKEND_API_PREFIX=
TRUST_PROXY=
SLOW_REQUEST_MS=2000
PDF_CONCURRENCY=1
BULK_PDF_MAX_CERTIFICATES=50
REPORT_EXPORT_MAX_ROWS=10000
SEARCH_RATE_LIMIT=120
UPLOAD_RATE_LIMIT=60
PDF_RATE_LIMIT=40
EMAIL_RATE_LIMIT=30

# Optional backup defaults used by scripts/backup-atec.ps1
BACKUP_ROOT=D:\ATECBackups
ATEC_BACKUP_ROOT=
BACKUP_MAX_AGE_HOURS=26
DISK_WARNING_PERCENT=85
DISK_CRITICAL_PERCENT=95
MEMORY_WARNING_PERCENT=90
BUILD_ID=
BUILD_DATE=
FRONTEND_BUILD_ID=
UPLOAD_ROOT=D:\ATECUploads
UPLOADS_PATH=
UPLOAD_IMAGE_MAX_WIDTH=1600
UPLOAD_IMAGE_MAX_HEIGHT=1600
UPLOAD_IMAGE_QUALITY=72
UPLOAD_COMPRESS_MIN_BYTES=512000
UPLOAD_COMPRESSION_CONCURRENCY=2

# Required for HTML-to-PDF certificate generation when Chromium is not bundled.
# Example Windows Edge path:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=

# Required for emailing certificate PDFs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ATEC <no-reply@example.com>

# Production example for https://www.fbcranes.co.za/atec
# NODE_ENV=production
# FRONTEND_ORIGIN=https://www.fbcranes.co.za
# PUBLIC_APP_URL=https://www.fbcranes.co.za/atec
# PUBLIC_BASE_PATH=/atec
# BACKEND_API_PREFIX=/api
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# COOKIE_PATH=/atec
# TRUST_PROXY=1
# DB_POOL_MAX=15
# DB_STATEMENT_TIMEOUT_MS=30000
# PDF_CONCURRENCY=1
# BULK_PDF_MAX_CERTIFICATES=50
# REPORT_EXPORT_MAX_ROWS=10000
# SEARCH_RATE_LIMIT=120
# UPLOAD_RATE_LIMIT=60
# PDF_RATE_LIMIT=40
# EMAIL_RATE_LIMIT=30
# SLOW_REQUEST_MS=2000
# UPLOAD_COMPRESSION_CONCURRENCY=2
# UPLOAD_ROOT=/var/www/atec/uploads
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
