DB_HOST=localhost
DB_PORT=5432
DB_NAME=atec
DB_USER=postgres
DB_PASSWORD=change-me
DB_SCHEMA=atec
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_APPLICATION_NAME=atec-backend

PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5174,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
# The auth cookie maxAge is derived from JWT_EXPIRES_IN so browser session lifetime matches the token.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
JSON_BODY_LIMIT=1mb
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BASE_PATH=/
BACKEND_API_PREFIX=
TRUST_PROXY=
SLOW_REQUEST_MS=2000
PDF_CONCURRENCY=1
BULK_PDF_MAX_CERTIFICATES=50
REPORT_EXPORT_MAX_ROWS=10000
SEARCH_RATE_LIMIT=120
SEARCH_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT=60
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
PDF_RATE_LIMIT=40
PDF_RATE_LIMIT_WINDOW_MS=900000
EXPORT_RATE_LIMIT=60
EXPORT_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RATE_LIMIT=30
EMAIL_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Optional backup defaults. Use Ubuntu paths in production.
BACKUP_ROOT=
ATEC_BACKUP_ROOT=
BACKUP_MAX_AGE_HOURS=26
BACKUP_VERIFY_MAX_AGE_HOURS=30
RESTORE_VERIFY_MAX_AGE_HOURS=192
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12
RESTORE_VERIFY_DB_PREFIX=atec_restore_verify_
RESTORE_VERIFY_ENABLED=false
BACKUP_MEDIA_ROOT=
BACKUP_LOCK_DIR=
BACKUP_NEXT_SCHEDULED_AT=
DISK_WARNING_PERCENT=85
DISK_CRITICAL_PERCENT=95
MEMORY_WARNING_PERCENT=90
BUILD_ID=
BUILD_DATE=
FRONTEND_BUILD_ID=
UPLOAD_ROOT=
UPLOADS_PATH=
UPLOAD_IMAGE_MAX_WIDTH=1600
UPLOAD_IMAGE_MAX_HEIGHT=1600
UPLOAD_IMAGE_QUALITY=72
UPLOAD_COMPRESS_MIN_BYTES=512000
UPLOAD_COMPRESSION_CONCURRENCY=2

# Required for HTML-to-PDF certificate generation when Chromium is not bundled.
# Example Ubuntu Chromium path:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# Required for emailing certificate PDFs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ATEC <no-reply@example.com>

# Recommended for Microsoft 365 (OAuth 2.0 / Microsoft Graph).
# When MAIL_PROVIDER=graph, the SMTP settings above are ignored.
MAIL_PROVIDER=graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=certificates@atecinspections.co.za

# Production example for https://www.atecinspections.co.za/
# NODE_ENV=production
# FRONTEND_ORIGIN=https://www.atecinspections.co.za
# PUBLIC_APP_URL=https://www.atecinspections.co.za
# PUBLIC_BASE_PATH=/
# BACKEND_API_PREFIX=/api
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# COOKIE_PATH=/
# TRUST_PROXY=1
# DB_POOL_MAX=15
# DB_STATEMENT_TIMEOUT_MS=30000
# PDF_CONCURRENCY=1
# BULK_PDF_MAX_CERTIFICATES=50
# REPORT_EXPORT_MAX_ROWS=10000
# SEARCH_RATE_LIMIT=120
# SEARCH_RATE_LIMIT_WINDOW_MS=60000
# UPLOAD_RATE_LIMIT=60
# UPLOAD_RATE_LIMIT_WINDOW_MS=900000
# PDF_RATE_LIMIT=40
# PDF_RATE_LIMIT_WINDOW_MS=900000
# EXPORT_RATE_LIMIT=60
# EXPORT_RATE_LIMIT_WINDOW_MS=900000
# EMAIL_RATE_LIMIT=30
# EMAIL_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# JSON_BODY_LIMIT=1mb
# SLOW_REQUEST_MS=2000
# UPLOAD_COMPRESSION_CONCURRENCY=2
# UPLOAD_ROOT=/var/www/atec/ATEC/backend/uploads
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
